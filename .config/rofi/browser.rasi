@import "color.rasi"

configuration {
    show-icons: false;
    font: "JetBrainsMonoNL Nerd Font SemiBold 11";
}

window {
    width: 85%;
    location: northwest;
    anchor: center;
    x-offset:                    60px;
    y-offset:                   -35px;
    background-color:            #101010; 
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;


}

mainbox {
    orientation: horizontal;
    spacing: 10px;
}

inputbar {
    expand: false;
    width: 15%;
}


listview {
    enabled:                     true;
    columns:                     1;
    lines:                       50;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      horizontal;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               false;
    flow:                       horizontal;
    expand: true;                                  
    margin-right:    0px;                          


    
    spacing:                     0.2em;
    margin:                      0px;
    padding:                     0px;
    margin-left:                10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  #ffffff;
    text-align:                  center;
    cursor:                      "default";
}


element-text, element-icon {
    horizontal-align: 0.5;
    width: 5em;      /* ancho fijo para cada entrada */
}
