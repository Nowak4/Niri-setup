@import "color.rasi"

configuration {
    show-icons: false;
    font: "JetBrainsMonoNL Nerd Font SemiBold 11";
}
mainbox {
    orientation: horizontal;
    spacing: 10px;
}

inputbar {
    expand: true;
    width: 15%;
	margin: 10px;
	padding: 0px;
	margin-bottom: 0px;
	margin-top: 0px;
}

window {
    /* properties for window widget */
    transparency:                "real";
    location:                    northwest;
    anchor:                      center;
    fullscreen:                  false;
    width:                       100%;
    height:                      40px;
    x-offset:                    0px;
    y-offset:                    0px;
    background-color:            #101010;  
    // background-image:            url("~/Imágenes/image(6).png",width);
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;
	font-weight: 9900;




}


listview {
    enabled:                     true;
    columns:                     1;
    lines:                       11;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      horizontal;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               false;
    flow:                       vertical;
    expand: true;                                  
    width:           100%;
    margin-right:    0px;                          


    
    spacing:                     0.5em;
    margin:                      0px;
    padding:                     0px;
    margin-left:                10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  #ffffff;
    text-align:                  center;
    cursor:                      "default";
    horizontal-align: 0;
}



